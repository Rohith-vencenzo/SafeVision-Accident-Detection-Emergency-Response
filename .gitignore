.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.env
.env.*
!.env.example
*.pt
*.onnx
*.engine
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v
outputs/*
!outputs/.gitkeep
incidents/*
!incidents/.gitkeep
logs/*
!logs/.gitkeep
test_clip/*
!test_clip/.gitkeep
# The two demo clips ARE committed so that a fresh clone can reproduce the
# documented commands and the screenshot evidence in README section 3.
# Generated annotated videos under outputs/ remain excluded.
!test_clip/*.mp4
models/*
!models/.gitkeep
!models/training-configuration.json
!models/performance-metrics.json

# Windows / editor / tooling noise
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.log

# Real manifest holds local absolute video paths; only the example is committed
evaluation_manifest.json

# On-Going progress are can not pushed, It is Intentionally done (don't modify)
/tests
*.md
# Re-include the docs the README links to. Must target the files (docs/*.md),
# not the directory: a bare !docs/ would not undo the *.md rule above.
!README.md
!docs/*.md
# Backend/README.md links to these two for endpoint contracts and operations,
# so excluding them would leave broken references for anyone cloning.
# Backend/TASK.md stays excluded, matching the root TASK.md decision above.
!Backend/API.md
!Backend/RUNBOOK.md