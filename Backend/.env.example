# Copy to .env and replace all CHANGE_ME values locally.
# Never commit .env or paste its contents into chat.
APP_ENV=development
# Unquoted CREATE DATABASE CrashPulse creates lowercase crashpulse in PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/crashpulse
# Optional: real integration tests create/drop only random test_crashpulse_* schemas.
# Set this locally to an authorized PostgreSQL database URL to enable them.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/crashpulse
JWT_SECRET=CHANGE_ME_generate_a_long_random_value_locally
TOKEN_ENCRYPTION_KEY=CHANGE_ME_generate_with_Fernet_generate_key
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=104857600
DETECTOR_CONFIG=
DETECTOR_MODEL=
DETECTOR_TIMEOUT_SECONDS=900
DETECTOR_MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=8
PRIVATE_DATA_DIR=private-data
ARTIFACT_RETENTION_DAYS=7
# No pushes are sent until authorized credentials and FCM_MODE=firebase exist.
FCM_MODE=disabled
FIREBASE_PROJECT_ID=crashpulse-clg
FIREBASE_CREDENTIALS_FILE=
NOTIFICATION_MAX_ATTEMPTS=5
DETECTOR_ROOT=
DETECTOR_PYTHON=
DETECTOR_ENTRYPOINT=
